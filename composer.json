{
    "name": "linkrobins/clipboard",
    "description": "Adds a copy-to-clipboard button to code blocks, plus an optional language label. Ported to Flarum 2.0 from ffans/clipboardjs.",
    "type": "flarum-extension",
    "keywords": [
        "flarum",
        "clipboard",
        "copy",
        "code",
        "syntax-highlighting"
    ],
    "support": {
        "issues": "https://github.com/linkrobins/clipboard/issues",
        "source": "https://github.com/linkrobins/clipboard"
    },
    "homepage": "https://linkrobins.com/extensions/clipboard",
    "license": "MIT",
    "authors": [
        {
            "name": "Link Robins",
            "email": "karl@linkrobins.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "extra": {
        "flarum-extension": {
            "title": "Link Robins Clipboard",
            "category": "feature",
            "icon": {
                "name": "far fa-clipboard",
                "color": "#07adcc",
                "backgroundColor": "#1a2535"
            }
        },
        "flarum-cli": {
            "modules": {
                "githubActions": true
            }
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
